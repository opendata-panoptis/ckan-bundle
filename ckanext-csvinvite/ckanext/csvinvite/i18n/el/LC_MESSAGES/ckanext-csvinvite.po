msgstr ""
"Συμβουλή: ξεκινήστε με ένα μικρό δείγμα (π.χ. 2–3 γραμμές) πριν "
"εκτελέσετε μια πλήρη μαζική ενέργεια."

#: ckanext/csvinvite/templates/csvinvite/admin_user_management.html:142
msgid "(org can be an id or slug)"
msgstr "(το org μπορεί να είναι id ή slug)"

#: ckanext/csvinvite/templates/csvinvite/admin_user_management.html:150
msgid "(you may provide either one)."
msgstr "(μπορείτε να δώσετε οποιοδήποτε από τα δύο)."

